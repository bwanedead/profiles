{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 2,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "python",
          "style": "powerline",
          "foreground": "#071A10",
          "background": "#38F08A",
          "template": "{{ if .Venv }}  {{ .Venv }} {{ end }}",
          "options": {
            "display_mode": "environment",
            "fetch_virtual_env": true,
            "fetch_version": false
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "#1F1A10",
          "background": "#FFE08A",
          "template": " {{ .HEAD }} ",
          "options": {
            "fetch_status": true,
            "fetch_stash_count": true
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "#0B1220",
          "background": "#B9E6FF",
          "template": "{{ if gt .Ahead 0 }} ↑{{ .Ahead }}{{ end }}{{ if gt .Behind 0 }} ↓{{ .Behind }}{{ end }} ",
          "options": {
            "fetch_status": true,
            "fetch_stash_count": true
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "#2B0E12",
          "background": "#FFB3C1",
          "template": "{{ if .Working.Changed }} M{{ add (add .Working.Modified .Working.Deleted) .Working.Untracked }}{{ end }} ",
          "options": {
            "fetch_status": true,
            "fetch_stash_count": true
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "#170B28",
          "background": "#D8B4FE",
          "template": "{{ if .Staging.Changed }} S{{ add (add .Staging.Added .Staging.Modified) .Staging.Deleted }}{{ end }} ",
          "options": {
            "fetch_status": true,
            "fetch_stash_count": true
          }
        },
        {
          "type": "git",
          "style": "powerline",
          "foreground": "#0B1F16",
          "background": "#BFE8D5",
          "template": "{{ if gt .StashCount 0 }} ≡{{ .StashCount }}{{ end }} ",
          "options": {
            "fetch_status": true,
            "fetch_stash_count": true
          }
        },
        {
          "type": "path",
          "style": "powerline",
          "foreground": "#FFF3EC",
          "background": "#C24D2C",
          "template": " {{ .Path }} ",
          "options": {
            "style": "full"
          }
        }
      ]
    },
    {
      "type": "rprompt",
      "alignment": "right",
      "segments": [
        {
          "type": "executiontime",
          "style": "powerline",
          "foreground": "#0B1220",
          "background": "#BFE8D5",
          "template": " 󱎫 {{ .FormattedMs }} ",
          "options": {
            "threshold": 800
          }
        },
        {
          "type": "status",
          "style": "powerline",
          "foreground": "#FFFFFF",
          "background": "#FF6B6B",
          "template": " ERR {{ .Code }} "
        },
        {
          "type": "time",
          "style": "powerline",
          "foreground": "#0B1220",
          "background": "#D9D9D9",
          "template": "  {{ .CurrentDate | date \"15:04\" }} "
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#D9D9D9",
          "template": "❯ "
        }
      ]
    }
  ]
}
